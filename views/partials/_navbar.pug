header.site-header
  .site-main
    nav.navbar
      a.navbar__brand(href="/") Healthy Lifestyle Hub

      ul.navbar__menu
        li
          a(href="/posts") Blog
        li
          a(href="/products") Products
        li
          a(href="/contact") Contact
        if !currentUser
          li
            a(href="/login") Login
          li
            a(href="/register") Sign Up
        else
          li
            form(action="/logout" method="POST" style="display:inline;")
              button(type="submit" style="background:none;border:none;color:inherit;cursor:pointer;font:inherit;font-weight:500;") Logout