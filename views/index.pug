extends layout

block content
  .card.hero
    div
      h1 Live Healthier, Every Day
      p Explore wellness articles and discover curated health products.
    img(src="/images/jogging.jpg", alt="People jogging
    <img src="/images/jogging.jpg" alt="People jogging">

  .grid-2
    section
      h2.section-title Latest Blog Posts
      if posts && posts.length
        ul.list
          each post in posts
            li.item
              - const imgSrc = post.imageUrl ? post.imageUrl : "/images/water.jpg"
              img(src=imgSrc, alt=post.title)
              div
                h3
                  a(href=`/posts/${post._id}`)= post.title
                p Posted on #{new Date(post.createdAt).toDateString()}
      else
        .card
          p No posts yet.

    section
      h2.section-title Featured Products
      if products && products.length
        ul.list
          each product in products
            li.item
              - const imgSrc = product.imageUrl ? product.imageUrl : "/images/protein.jpg"
              img(src=imgSrc, alt=product.name)
              div
                h3
                  a(href=`/products/${product._id}`)= product.name
                p $#{Number(product.price || 0).toFixed(2)}
      else
        .card
          p No products yet.
