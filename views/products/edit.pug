extends ../layout

block content
  h2 Edit Product
  form(method="POST", action=`/products/${product._id}?_method=PUT`)
    label Name
    input(type="text", name="name", required, value=product.name)

    label Description
    textarea(name="description", required)= product.description

    label Price
    input(type="number", name="price", required, value=product.price)

    label Category
    input(type="text", name="category", value=product.category)

    label Image URL
    input(type="text", name="imageUrl", value=product.imageUrl)

    label In Stock
    input(type="checkbox", name="inStock", checked=product.inStock)

    button(type="submit") Update
