extends ../layout

block content
  h1 Products

  if !products || products.length === 0
    p No products yet.
  else
    .cards
      each product in products
        a.card(href=`/products/${product._id}`)
          if product.image
            img.card__img(src=`/images/${product.image}` alt=product.name)
          h3.card__title= product.name
          if product.price
            p.meta $#{product.price.toFixed(2)}